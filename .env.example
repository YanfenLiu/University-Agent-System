# Copy this file to .env. Never commit the real .env file.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_DB_PASSWORD=your_database_password

# Render calls GitHub Actions to run long refresh jobs.
# Fine-grained token permission: selected repository > Actions > Read and write.
GITHUB_ACTIONS_TOKEN=your_fine_grained_github_token
GITHUB_REPOSITORY=Yhrjkcz1/University-Agent-System
GITHUB_REFRESH_WORKFLOW=refresh-competitions.yml
GITHUB_REFRESH_REF=main
REFRESH_IP_HASH_SALT=replace_with_a_random_secret

# JWT authentication (generate a 64-char hex string for production)
JWT_SECRET_KEY=replace_with_64_character_random_hex_string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS allowed origins (comma-separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,https://saizhitong.example.com

# Keep false on Render's 512 MB plan. To enable locally, also install
# requirements-embedding.txt.
ENABLE_LOCAL_EMBEDDING=false

# Optional legacy Gradio server settings. Cloud platforms override these values.
HOST=127.0.0.1
PORT=7860
