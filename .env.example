# Copy this file to .env. Never commit the real .env file.
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_MODEL=deepseek-chat

# Supabase cloud storage (free 500MB PostgreSQL).
# Get these from https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-side refresh writes; never expose this value to the Vite frontend.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Database password for auto-creating tables on first run.
# Found in Supabase Dashboard > Settings > Database > Connection string
SUPABASE_DB_PASSWORD=your_database_password

# Render calls GitHub Actions to run long refresh jobs.
GITHUB_ACTIONS_TOKEN=your_fine_grained_github_token
GITHUB_REPOSITORY=Yhrjkcz1/University-Agent-System
GITHUB_REFRESH_WORKFLOW=refresh-competitions.yml
GITHUB_REFRESH_REF=main
REFRESH_IP_HASH_SALT=replace_with_a_random_secret

# Optional local Gradio server settings. Cloud platforms override these values.
HOST=127.0.0.1
PORT=7860
